{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBuds",
  "version": "0.1.0",
  "identifier": "io.openbuds.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenBuds",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Control your wireless earbuds",
    "longDescription": "A modern cross-platform client for configuring your wireless earbuds — sound modes, equalizer, button controls and more.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
